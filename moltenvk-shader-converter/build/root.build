# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

# Unlike libmoltenvk, this package never reaches MoltenVK's public API
# headers (no mvk_datatypes.h -> CoreGraphics.h), so the cxx.std=latest /
# Apple-SDK-header issue that forced libmoltenvk to pin to 17 doesn't apply
# here.
cxx.std = latest

using cxx
using cxx.objcxx # OSSupport.mm is Objective-C++.

assert ($cxx.target.class == 'macos') \
  'moltenvk-shader-converter is macOS-only'

assert ($cxx.id.type == 'clang') \
  'moltenvk-shader-converter requires clang (Objective-C++ and Metal frameworks)'

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp
h{*}:   extension = h
