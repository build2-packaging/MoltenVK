libs = # No interface/implementation split for executables.

import libs += libmoltenvk%lib{MoltenVK}
import libs += libspirv-cross%lib{spirv-cross-msl}

# xxd -- build-time host tool used only to decode the smoke-test SPIR-V
# fixture (noop.spv.hex -> noop.spv). See the ad hoc recipe below. Not a
# test-runtime dependency.
#
import! [metadata] xxd = xxd%exe{xxd}

# Build-time decode of the no-op compute SPIR-V fixture used by the smoke
# test (same shader as libmoltenvk/tests/basics/driver.cpp). Generated into
# out, never installed.
#
file{noop.spv}: file{noop.spv.hex}@./ $xxd
{{
  diag xxd ($>)
  $xxd -r -p $path($<[0]) $path($>)
}}

file{noop.spv}:     install = false
file{noop.spv.hex}: install = false

# exe{MoltenVKShaderConverter} -- mixed case, matching upstream's literal
# add_executable(MoltenVKShaderConverter ...) name, same deliberate-deviation
# precedent as lib{MoltenVK} in libmoltenvk.
#
# {h cxx mm}{*} picks up the tool sources plus the flat header-only
# reachability symlinks (SPIRVToMSLConverter.h, FileSupport.h, etc.). Those
# headers' implementations are already compiled into lib{MoltenVK}, do not
# add their .cpp/.mm here.
#
# file{noop.spv} is an ad hoc runtime fixture for the smoke test (not a link
# input). Its out-tree path is exposed to the testscript as $spv.
#
./: exe{MoltenVKShaderConverter}
exe{MoltenVKShaderConverter}: {h cxx mm}{*} $libs testscript
exe{MoltenVKShaderConverter}: file{noop.spv}: include = adhoc
exe{MoltenVKShaderConverter}: spv = $out_base/noop.spv

# Flat -I so quoted includes resolve via the src/ header symlinks. Upstream
# sources use bare "Header.h" names (no directory prefix). Compilers follow
# the real path of symlinked .cpp/.mm files, so without -I$src_base they
# would look next to the upstream Tool/ directory instead of here.
#
cxx.poptions += "-I$src_base"
