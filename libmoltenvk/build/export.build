$out_root/
{
  include src/
  include icd/
  include direct-util/
}

if ($import.target == json{MoltenVK_icd} || \
    $import.target == json{MoltenVK_icd-bundle})
  export $out_root/icd/$import.target
elif ($name($import.target) == 'mvk-direct-util')
  export $out_root/direct-util/$import.target
else
  export $out_root/src/$import.target
