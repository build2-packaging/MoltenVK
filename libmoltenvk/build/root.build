# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

# Pinned to 17, matching upstream's own CMAKE_CXX_STANDARD/CXX_STANDARD_REQUIRED
# (CMakeLists.txt). cxx.std=latest (Apple clang defaulting to a newer draft
# standard) triggers hard errors in Apple's own CoreGraphics/ColorSync system
# headers (invalid arithmetic between different enumeration types) that don't
# occur under c++17 -- an SDK header issue, not a MoltenVK one.
cxx.std = 17

using c
using c.objc   # MTLSamplerDescriptor+MoltenVK.m and friends (plain Objective-C).
using cxx
using cxx.objcxx # The bulk of MoltenVK/MoltenVK/**.mm (Objective-C++).
using in

hxx{*}: extension = hpp # Only Vulkan/mvk_datatypes.hpp; everything else is h{}.
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp
h{*}:   extension = h

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

# Mirrors upstream's MVK_EXCLUDE_SPIRV_TOOLS/MVK_EXCLUDE_CEREAL/
# MVK_USE_METAL_PRIVATE_API/MVK_CONFIG_LOG_LEVEL CMake options.
#
config [bool]   config.libmoltenvk.exclude_spirv_tools    ?= true
config [bool]   config.libmoltenvk.exclude_cereal          ?= true
config [bool]   config.libmoltenvk.use_metal_private_api  ?= false
config [string] config.libmoltenvk.log_level                ?= 'info'

assert ($config.libmoltenvk.log_level == 'debug' || \
        $config.libmoltenvk.log_level == 'info'  || \
        $config.libmoltenvk.log_level == 'warn'  || \
        $config.libmoltenvk.log_level == 'error' || \
        $config.libmoltenvk.log_level == 'off')     \
       'invalid config.libmoltenvk.log_level'

# Neither SPIRV-Tools/SPIRV-Headers nor cereal is packaged yet (see
# ../../PACKAGING.md), so fail clearly rather than silently mis-build if
# either exclude flag is ever turned off.
#
assert $config.libmoltenvk.exclude_spirv_tools \
  'config.libmoltenvk.exclude_spirv_tools=false requires SPIRV-Tools/SPIRV-Headers, not yet packaged'
assert $config.libmoltenvk.exclude_cereal \
  'config.libmoltenvk.exclude_cereal=false requires cereal, not yet packaged'
