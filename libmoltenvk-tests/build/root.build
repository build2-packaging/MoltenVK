# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = 17

using cxx

assert ($cxx.target.class == 'macos') \
  'libmoltenvk-tests is macOS-only'

assert ($cxx.id.type == 'clang') \
  'libmoltenvk-tests requires clang'

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
